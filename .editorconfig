# EditorConfig helps maintain consistent coding styles across editors/IDEs
# https://editorconfig.org

# top-most EditorConfig file
root = true

# Apply these general rules to all files
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 2

# Lua indentation must agree with .stylua.toml.
[*.lua]
indent_style = space
indent_size = 2

# Make requires recipe lines to begin with tabs.
[Makefile]
indent_style = tab
